# Machine-specific hosts and identity files belong in this unmanaged directory.
# Includes are intentionally first so local values win over generic defaults.
Include ~/.ssh/config.d/*

# OrbStack manages this file when installed.
Include ~/.orbstack/ssh/config

Host github.com
    HostName github.com
    User git
    AddKeysToAgent yes
    UseKeychain yes

Host *
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
