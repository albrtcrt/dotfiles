# ~/.bashrc: interactive Bash configuration for supported Linux hosts.

case $- in
  *i*) ;;
  *) return ;;
esac

# Fedora and related distributions expect each user's Bash configuration to
# load the system-wide interactive defaults, including their standard prompt.
if [ -r /etc/bashrc ]; then
  . /etc/bashrc
fi

# Preserve a useful prompt on distributions that leave Bash's minimal default
# unchanged. Bash expands these escapes when it displays the prompt.
if [ "${PS1-}" = '\s-\v\$ ' ]; then
  PS1='\u@\h:\w\$ '
fi

HISTCONTROL=ignoreboth
HISTSIZE=5000
HISTFILESIZE=10000
shopt -s histappend checkwinsize

if command -v dircolors >/dev/null 2>&1; then
  if [ -r "$HOME/.dircolors" ]; then
    eval "$(dircolors -b "$HOME/.dircolors")"
  else
    eval "$(dircolors -b)"
  fi
  alias ls='ls --color=auto'
fi

alias ll='ls -alF'

if [ -r "$HOME/.bash_aliases" ]; then
  . "$HOME/.bash_aliases"
fi

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
fi
